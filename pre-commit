# Точный путь к вашему файлу стилей
CONFIG_PATH="materials/linters/.clang-format"

# Находим измененные C/C++ файлы перед коммитом
FILES=$(git diff --cached --name-only --diff-filter=ACM | grep -E '\.(cpp|hpp|c|h)$')

# Если измененных C/C++ файлов нет — пропускаем проверку
if [ -z "$FILES" ]; then
    exit 0
fi

AUTO_FIXED=false

# Проверяем каждый измененный файл
for FILE in $FILES; do
    if [ -f "$FILE" ]; then
        # Проверяем стиль с помощью флага -n (dry-run)
        clang-format -n --Werror -style=file:"$CONFIG_PATH" "$FILE" 2>/dev/null
        
        # Если код возврата не 0 (есть ошибки форматирования)
        if [ $? -ne 0 ]; then
            echo "🔧 Найдено неверное форматирование в: $FILE. Исправляю..."
            
            # Запускаем автоматическое исправление прямо в файл через флаг -i
            clang-format -i -style=file:"$CONFIG_PATH" "$FILE"
            
            # Заново добавляем исправленный файл в индекс для коммита
            git add "$FILE"
            AUTO_FIXED=true
        fi
    fi
done

if [ "$AUTO_FIXED" = true ]; then
    echo "✅ Все файлы автоматически отформатированы и добавлены в коммит!"
else
    echo "✅ Все файлы изначально соответствовали стилю!"
fi

exit 0
