# Точный путь к файлу стилей относительно корня репозитория
CONFIG_PATH="materials/linters/.clang-format"
TARGET_DIR="src"

echo "🚀 [Pre-Commit] Запуск форматирования всех файлов .c и .h в папке $TARGET_DIR..."

# Проверяем, существует ли папка src
if [ ! -d "$TARGET_DIR" ]; then
    echo "⚠️ Папка $TARGET_DIR не найдена. Пропускаем."
    exit 0
fi

# Находим все файлы .c и .h в папке src (и её подпапках) и форматируем их за один запуск.
# Круглые скобки \( ... \) группируют условия, а -o означает "ИЛИ".
find "$TARGET_DIR" -type f \( -name "*.c" -o -name "*.h" \) -exec clang-format -i -style=file:"$CONFIG_PATH" {} +

# Добавляем все измененные .c и .h файлы обратно в индекс коммита
find "$TARGET_DIR" -type f \( -name "*.c" -o -name "*.h" \) -exec git add {} +

echo "✅ Все файлы .c и .h в папке $TARGET_DIR успешно отформатированы и добавлены в коммит!"
exit 0
