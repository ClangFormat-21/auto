# Точный путь к файлу стилей относительно корня репозитория
CONFIG_PATH="materials/linters/.clang-format"
TARGET_DIR="src"

echo "🚀 [Pre-Commit] Запуск форматирования всех файлов .c в папке $TARGET_DIR..."

# Проверяем, существует ли папка src
if [ ! -d "$TARGET_DIR" ]; then
    echo "⚠️ Папка $TARGET_DIR не найдена. Пропускаем."
    exit 0
fi

# Находим все файлы .c в папке src (и её подпапках) и форматируем их за один запуск.
# Конструкция + в конце xargs или find заменяет долгий цикл и работает мгновенно.
find "$TARGET_DIR" -type f -name "*.c" -exec clang-format -i -style=file:"$CONFIG_PATH" {} +

# Добавляем все измененные .c файлы обратно в индекс коммита
# (Используем find, чтобы git add добавил именно те файлы, которые мы только что отформатировали)
find "$TARGET_DIR" -type f -name "*.c" -exec git add {} +

echo "✅ Все файлы .c в папке $TARGET_DIR успешно отформатированы и добавлены в коммит!"
exit 0
