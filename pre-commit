# Точный путь к файлу стилей относительно корня репозитория
CONFIG_PATH="materials/linters/.clang-format"

echo "🚀 [Pre-Commit] Запуск принудительного форматирования ВСЕХ файлов проекта..."

# Флаг для проверки, нашли ли мы хоть один файл
FOUND_FILES=false

# Находим ВСЕ C/C++ файлы в репозитории.
# Исключаем папку .git и build, чтобы скрипт не испортил системные файлы.
# Конструкция с -print0 и read -d '' гарантирует 100% защиту от пробелов в путях.
find . \( -name ".git" -o -name "build" \) -prune -o \
-type f -regextype posix-extended -regex '.*\.(cpp|hpp|c|h)$' -print0 | while IFS= read -r -d '' FILE; do
    
    echo "🔧 Форматирую: $FILE"
    
    # Форматируем файл
    clang-format -i -style=file:"$CONFIG_PATH" "$FILE"
    
    # Принудительно добавляем в текущий коммит
    git add "$FILE" 2>/dev/null
    
    FOUND_FILES=true
done

# Если файлов в проекте вообще нет
if [ "$FOUND_FILES" = false ]; then
    echo "⚠️ Файлы C/C++ в проекте не найдены."
fi

echo "✅ [Pre-Commit] Все файлы проекта успешно отформатированы и добавлены в коммит!"
exit 0
